# Build directories
build/
builddir/
.build/

# WrapDB downloaded subproject sources (fetched/extracted by meson setup).
# nsync/cpptoml/cpptrace use wraps with patch_directory overlays + a deletion
# diff (see subprojects/packagefiles/); their extracted trees match the
# upstream tarball's leading directory name (a git SHA).
subprojects/spdlog-*/
subprojects/googletest-*/
subprojects/nsync-*/
subprojects/cpptoml-*/
subprojects/cpptrace-*/
subprojects/packagecache/

# IDE / editor
.cache/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Compiled objects
*.o
*.a
*.so
*.dylib

# Test datasets and benchmark artifacts (large corpora stay local;
# the mini* fixtures are committed for tests — see datasets/README.md)
datasets/*
!datasets/mini10k_base.fbin
!datasets/mini10k_query.fbin
!datasets/mini10k_gt.gtmm
!datasets/mini20k_base.fbin
!datasets/mini20k_query.fbin
!datasets/mini20k_gt.gtmm
!datasets/README.md
*.fbin
*.bvec
*.fvec
*.gt
# Exception: committed test fixtures (SIFTsmall)
!test/data/*.fbin
!test/data/*.gt

# Profiler output
*.profraw
profile_results/
profiles/
*.samply
subprojects/.wraplock
subprojects/packagecache/

# Committed dataset fixtures (must come after the *.fbin rule above).
!datasets/mini10k_base.fbin
!datasets/mini10k_query.fbin
!datasets/mini20k_base.fbin
!datasets/mini20k_query.fbin

# Canonical benchmark outputs stay local (archived privately)
results/
